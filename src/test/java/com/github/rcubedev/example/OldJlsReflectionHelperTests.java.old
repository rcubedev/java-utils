package com.example;

import reflect.com.github.rcubedev.example.Argument;
import com.example.reflect.OldJlsReflectionHelper;
import reflect.com.github.rcubedev.example.TypedClass;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

class OldJlsReflectionHelperTests {

    // --- Mock Classes for Testing ---

    static class AmbiguityTarget {
        public String result;
        public AmbiguityTarget(String s, Object o) { this.result = "String, Object"; }
        public AmbiguityTarget(Object o, String s) { this.result = "Object, String"; }
    }

    static class VarargsTarget {
        public int count;
        public boolean arrayPassedDirectly;
        public VarargsTarget(String... args) {
            this.count = args.length;
        }
        public VarargsTarget(Object[] args) {
            this.arrayPassedDirectly = true;
        }
    }

    static class DualVarargsTarget {
        public int count;
        public boolean objectVarArgsPassedDirectly;
        public DualVarargsTarget(String... args) {
            this.count = args.length;
        }
        public DualVarargsTarget(Object... args) {
            this.objectVarArgsPassedDirectly = true;
        }
    }

    static class BoxingWideningTarget {
        public String type;
        public BoxingWideningTarget(long l) { this.type = "primitive long"; }
        public BoxingWideningTarget(Integer i) { this.type = "wrapper Integer"; }
    }

    static class Outer {
        class Inner {
            public String val;
            public Inner(String val) { this.val = val; }
            public Inner(Outer outer, String val, Object a) { this.val = val; }
        }
    }

    // --- Test Cases ---

    @Test
    void argumentNullPrim() {
        assertThrows(NullPointerException.class, () -> Argument.of(null, new TypedClass<>() {}), "Should have thrown exception due to primitive type and null object");
    }

    @Test
    void testAmbiguityDetection() {
        // JLS §15.12.2.1: Neither (String, Object) nor (Object, String) is more specific
        // for arguments (String, String). Should throw exception.
        assertThrows(RuntimeException.class, () -> {
            OldJlsReflectionHelper.instantiate(AmbiguityTarget.class, null, null, "a", "b");
        }, "Should detect ambiguity between String,Object and Object,String");
    }

    @Test
    void testVarargsArrayIdentity() {
        // JLS §15.12.4.2: Passing a pre-constructed array should not be re-wrapped.
        String[] input = {"a", "b", "c"};
        VarargsTarget target = OldJlsReflectionHelper.instantiate(VarargsTarget.class, null, null, (Object) input);

        assertEquals(3, target.count, "Should have unpacked the array into 3 arguments");
    }

    @Test
    void testDualVarargsIdentity() {
        String[] input = {"a", "b", "c"};
        DualVarargsTarget target = OldJlsReflectionHelper.instantiate(DualVarargsTarget.class, null, null, (Object) input);

        assertEquals(3, target.count, "Should have unpacked the array into 3 arguments");
    }

    @Test
    void testUpcastDualVarargsIdentity() {
        String[] _input = {"a", "b", "c"};
        Object[] input = _input;
        DualVarargsTarget target = OldJlsReflectionHelper.instantiate(DualVarargsTarget.class, null, new Class<?>[]{ Object[].class }, (Object) input);

        assertTrue(target.objectVarArgsPassedDirectly, "Should have utilized the object varargs");
    }

    @Test
    void testBoxingThenWideningDisallowed() {
        // int -> long (Widening) is Phase 1
        // Integer -> int (Unboxing) is Phase 2
        // int -> Long (Widening then Boxing) is ILLEGAL in JLS §5.3

        // This should match the 'long' constructor via widening (Phase 1)
        BoxingWideningTarget target = OldJlsReflectionHelper.instantiate(BoxingWideningTarget.class, null, new Class<?>[]{ int.class }, 10);
        assertEquals("primitive long", target.type);
    }

    @Test
    void testUnboxingThenWideningAllowed() {
        // Integer -> long (Unbox to int, then widen to long)
        // This tests Phase 2 logic.
        BoxingWideningTarget target = OldJlsReflectionHelper.instantiate(
                BoxingWideningTarget.class, null, null, Integer.valueOf(10)
        );
        // Note: It prefers the Integer constructor because it's Phase 2 Identity vs Phase 2 Widening
        assertEquals("wrapper Integer", target.type);
    }

    @Test
    void testInnerClassInstantiation() {

        Outer outerInstance = new Outer();
        // The helper should handle the synthetic 'this$0' prepending
        Outer.Inner inner = OldJlsReflectionHelper.instantiate(Outer.Inner.class, null, null, outerInstance, "test");

        assertNotNull(inner);
        assertEquals("test", inner.val);
    }

    @Test
    void testInnerClassInstantiationTwoPassedIn() {

        Outer outerInstance = new Outer();
        // The helper should handle the synthetic 'this$0' prepending
        Outer.Inner inner = OldJlsReflectionHelper.instantiate(Outer.Inner.class, null, null, outerInstance, outerInstance, "test", new Object());

        assertNotNull(inner);
        assertEquals("test", inner.val);
    }
}